# Algos AI Brain - optional LLM mode (server-side key)
# Copy this file to `.env` and fill in YOUR OWN key. The app never ships or
# reads any other API key. Without these the chat keeps running offline.
#
# USER_LLM_API_KEY=sk-your-api-key-here
# USER_LLM_BASE_URL=https://api.openai.com/v1
# USER_LLM_MODEL=gpt-4o-mini
#
# OpenAI-compatible endpoints work too, e.g. Groq:
# USER_LLM_BASE_URL=https://api.groq.com/openai/v1
# USER_LLM_MODEL=openai/gpt-oss-120b
#
# or DeepSeek:
# USER_LLM_BASE_URL=https://api.deepseek.com/v1
# USER_LLM_MODEL=deepseek-chat
# Tip: after saving a key in the Brain settings, use "Fetch available models"
# to list the models your account can actually reach.
