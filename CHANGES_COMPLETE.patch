+      list.forEach(s => {
+        if (s[3] === 'INDEX') push({ name: s[0], id: Number(s[1]), exch: s[2], inst: s[3], ocId: s[4], ocExch: s[5], grp: s[6] });
+      });
+    }
+    return out;
+  }
