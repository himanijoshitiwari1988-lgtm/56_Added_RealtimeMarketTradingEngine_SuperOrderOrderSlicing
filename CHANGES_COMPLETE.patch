+def _parse_json_obj(s):
+    if not s:
+        return None
+    s = str(s).strip()
+    a = s.find("{")
+    b = s.rfind("}")
+    if a >= 0 and b > a:
+        s = s[a:b + 1]
+    try:
+        obj = json.loads(s)
+        return obj if isinstance(obj, dict) else None
+    except Exception:
+        try:
+            start = s.find('{"')
+            if start < 0:
+                return None
+            depth = 0
+            for i in range(start, len(s)):
+                c = s[i]
+                if c == "{":
+                    depth += 1
+                elif c == "}":
+                    depth -= 1
+                    if depth == 0:
+                        obj = json.loads(s[start:i + 1])
+                        return obj if isinstance(obj, dict) else None
+        except Exception:
+            return None
+    return None
+
